# 1inch Aggregation API key (server-side only, never exposed to the browser).
# Get one at https://portal.1inch.dev
ONEINCH_API_KEY=

# RPC the frontend talks to. Defaults to the local anvil Base fork.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Reown AppKit project id (https://dashboard.reown.com). Public by design — it identifies the app
# to the WalletConnect relay. Without one the connect button skips the modal and connects an
# injected wallet directly, which is enough for a local fork but not for phones.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# The origin this app is served from. WalletConnect shows it to the wallet and checks it against
# where the request came from, so a wrong value makes every session read as unverified. Leave it
# unset locally: the browser's own origin is used.
NEXT_PUBLIC_APP_URL=
